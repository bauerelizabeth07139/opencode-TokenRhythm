{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "tokenrhythm-image-gen": {
      "type": "local",
      "command": ["python", "~/.config/opencode/mcp/tokenrhythm_image_mcp.py"],
      "enabled": true,
      "environment": {
        "TOKENRHYTHM_API_KEY": ""
      }
    }
  },
  "provider": {
    "tokenrhythm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRhythm (基元律动)",
      "options": {
        "baseURL": "https://tokenrhythm.studio/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "reasoning": true
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "reasoning": true
        },
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731",
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "reasoning": true
        },
        "deepseek-v4-pro-0813": {
          "name": "DeepSeek V4 Pro 0813",
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "reasoning": true
        },
        "seed-2.1-pro": {
          "name": "Seed 2.1 Pro",
          "limit": {
            "context": 262100,
            "output": 131100
          },
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": ["text", "image", "video"]
          }
        },
        "seed-2.1-turbo": {
          "name": "Seed 2.1 Turbo",
          "limit": {
            "context": 262100,
            "output": 131100
          },
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": ["text", "image", "video"]
          }
        },
        "glm-5": {
          "name": "GLM-5",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "reasoning": true
        },
        "glm-5.1": {
          "name": "GLM-5.1",
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "reasoning": true
        },
        "glm-5.2": {
          "name": "GLM-5.2",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "reasoning": true
        },
        "kimi-k2.5": {
