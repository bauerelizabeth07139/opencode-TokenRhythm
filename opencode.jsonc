            "context": 256000,
            "output": 64000
          },
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": ["text", "image"]
          }
        },
        "kimi-k2.6": {
          "name": "Kimi K2.6",
          "limit": {
            "context": 256000,
            "output": 128000
          },
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": ["text", "image"]
          }
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code",
          "limit": {
            "context": 256000,
            "output": 16000
          },
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": ["text", "image"]
          }
        },
        "mimo-v2.5-pro": {
          "name": "Mimo V2.5 Pro",
          "limit": {
            "context": 256000,
            "output": 256000
          },
          "reasoning": true
        },
        "minimax-m2.5": {
