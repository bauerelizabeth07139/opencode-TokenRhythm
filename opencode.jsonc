        "qwen-image-2.0": {
          "name": "Qwen Image 2.0",
          "limit": {
            "context": 0,
            "output": 0
          },
          "reasoning": false
        },
        "qwen3.7-max": {
          "name": "Qwen3.7 Max",
          "limit": {
            "context": 1000000,
            "output": 131100
          },
          "reasoning": true
        },
        "qwen3.8-max": {
          "name": "Qwen3.8 Max",
          "limit": {
            "context": 1000000,
